{
  "name": "@magistra/desktop",
  "version": "0.0.1",
  "private": true,
  "description": "App desktop Electron di Magistra: processi main, preload e renderer gestiti da electron-vite.",
  "license": "AGPL-3.0-or-later",
  "author": "Italian Builders",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "package": "electron-vite build && electron-builder --publish never",
    "package:dir": "electron-vite build && electron-builder --dir --publish never",
    "package:win": "electron-vite build && electron-builder --win --publish never",
    "package:mac": "electron-vite build && electron-builder --mac --publish never",
    "package:linux": "electron-vite build && electron-builder --linux --publish never",
    "release": "electron-vite build && electron-builder --publish onTagOrDraft",
    "test:security": "node --experimental-strip-types --experimental-default-type=module --test test/security/*.test.ts",
    "typecheck:node": "tsc --noEmit --composite false -p tsconfig.node.json",
    "typecheck:web": "tsc --noEmit --composite false -p tsconfig.web.json",
    "typecheck": "npm run typecheck:node && npm run typecheck:web"
  },
  "dependencies": {
    "@magistra/shared": "*",
    "@magistra/ui": "*",
    "electron-updater": "^6.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "42.6.0",
    "electron-builder": "^26.0.0",
    "electron-vite": "^5.0.0",
    "vite": "^6.0.0"
  }
}
