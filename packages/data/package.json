{
  "name": "@magistra/data",
  "version": "0.0.1",
  "private": true,
  "description": "Strato dati dell'applicazione: schema e CRUD delle entità applicative dietro un'interfaccia tipizzata, con motore PGlite embedded (Postgres in WASM) isolato e sostituibile, e migrazioni versionate.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.0",
    "zod": "^3.24.0"
  }
}
