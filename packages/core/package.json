{
  "name": "@magistra/core",
  "version": "0.0.1",
  "private": true,
  "description": "Core di orchestrazione indipendente dal trasporto: implementa il contratto tipizzato delle operazioni, invocabile direttamente e testabile senza Electron.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
