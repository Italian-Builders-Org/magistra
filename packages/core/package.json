      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test 'test/*.test.ts'",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@magistra/shared": "*",
    "zod": "^3.24.0"
  }
}
