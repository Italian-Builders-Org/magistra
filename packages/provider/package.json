{
  "name": "@magistra/provider",
  "version": "0.0.1",
  "private": true,
  "description": "Astrazione multi-provider LLM (Vercel AI SDK): confine tipizzato per generazione in streaming, tool calling ed embedding verso Anthropic, Google, OpenAI e qualunque endpoint OpenAI-compatibile, inclusi i runtime locali.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "sideEffects": false,
  "main": "./src/index.ts",
  "module": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "engines": {
    "node": ">=22.6"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.16",
    "@ai-sdk/google": "^4.0.18",
    "@ai-sdk/openai": "^4.0.16",
    "@ai-sdk/openai-compatible": "^3.0.12",
    "ai": "^7.0.31",
    "zod": "^3.24.0"
  }
}
